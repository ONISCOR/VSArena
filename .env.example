# Assumption: copy to `.env.local` and fill from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Official leaderboard writes: harness sends this as header x-vsarena-ingest (min 16 chars).
# Channel auth only — it is not the public receipt.
HARNESS_INGEST_SECRET=
# Ed25519 identity layer (PKCS8 / SPKI). Prefer one quoted line with \n; concatenated PEM and raw base64 also parse.
# node -e "const {generateKeyPairSync}=require('crypto'); const k=generateKeyPairSync('ed25519'); console.log(k.privateKey.export({type:'pkcs8',format:'pem'})); console.log(k.publicKey.export({type:'spki',format:'pem'}))"
# VSARENA_RESULTS_ED25519_PRIVATE="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# VSARENA_RESULTS_ED25519_PUBLIC="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Next app the harness POSTs results to.
VSARENA_APP_URL=http://127.0.0.1:3000
# SDK live clients (production hosted harness, or local npm run harness)
# VSARENA_HARNESS_URL=wss://vsarena-harness.onrender.com
# Browser spectator page /live uses the same host + /spectate (override base):
# NEXT_PUBLIC_HARNESS_WS_URL=wss://vsarena-harness.onrender.com
# HARNESS_PORT=8787
# Official ELO layouts (harness process). Unset: production → held_out, local npm run harness → public.
# VSARENA_SCENE_SET=public
# Private three-cube JSON for operators (not committed). See docs/eval-integrity.md
# VSARENA_HELD_OUT_JSON=
# Canonical public origin (OG, sitemap). On Vercel, VERCEL_URL is used if this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /privacy and /terms. Public name of the controller (founder).
NEXT_PUBLIC_LEGAL_CONTROLLER=Aran Kair
NEXT_PUBLIC_LEGAL_EMAIL=arankair.dev@gmail.com
